rules_version = '2';

// Aturan keamanan Nia Kasir. Rancangan lengkap: docs/RANCANGAN.md §8.
// Ditulis bertahap mengikuti tahapan; yang tidak diizinkan di sini otomatis DITOLAK.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
    }

    // Anggota aktif toko. Kasir yang dinonaktifkan pemilik langsung kehilangan akses.
    function isActiveMember(storeId) {
      return signedIn()
        && exists(memberPath(storeId))
        && get(memberPath(storeId)).data.isActive == true;
    }

    function isOwner(storeId) {
      return isActiveMember(storeId) && get(memberPath(storeId)).data.role == 'owner';
    }

    // Sama dengan STORE_NAME_MIN_LENGTH / MAX_LENGTH di src/config/limits.ts.
    function validStoreName(name) {
      return name is string && name.size() >= 2 && name.size() <= 40;
    }

    function optionalText(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    // Info toko & struk. Sama dengan batas di src/config/limits.ts.
    function validStoreProfile(data) {
      return validStoreName(data.name)
        && optionalText(data.address, 100)
        && optionalText(data.phone, 20)
        && data.lowStockThreshold is int && data.lowStockThreshold >= 0
        && optionalText(data.receipt.headerNote, 60)
        && data.receipt.footerNote is string && data.receipt.footerNote.size() <= 60
        && data.receipt.showCashier is bool;
    }

    // Sama dengan batas di src/config/limits.ts (nama barang, satuan, jumlah jenis).
    function validProduct(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.baseUnit is string && data.baseUnit.size() >= 1 && data.baseUnit.size() <= 20
        && (data.barcode == null || data.barcode is string)
        && data.stock is int && data.stock >= 0
        && data.trackStock is bool
        && data.isActive is bool
        && data.variants is list && data.variants.size() >= 1 && data.variants.size() <= 10;
    }

    // Penjualan tunai: milik kasir yang login, uang cukup, kembalian benar, waktu dari server.
    function validSale(data) {
      return data.cashierUid == request.auth.uid
        && data.total is int && data.total >= 0
        && data.cashReceived is int && data.cashReceived >= data.total
        && data.change == data.cashReceived - data.total
        && data.itemCount is int && data.itemCount >= 1
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && data.receiptNo is string
        && data.createdAt == request.time;
    }

    // Kasir (atau pemilik) mengurangi stok HANYA bersama penjualannya sendiri di transaksi yang sama.
    function isSaleStockUpdate(storeId) {
      let next = request.resource.data;
      return isActiveMember(storeId)
        && next.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastSaleId', 'updatedAt'])
        && next.stock is int && next.stock >= 0 && next.stock < resource.data.stock
        && getAfter(/databases/$(database)/documents/stores/$(storeId)/sales/$(next.lastSaleId)).data.cashierUid
          == request.auth.uid;
    }

    // Rekap harian: dokumen "{tanggal}_{uid}" milik kasir itu sendiri, angkanya hanya bertambah.
    function validDailyStat(statId) {
      let next = request.resource.data;
      return next.cashierUid == request.auth.uid
        && statId == next.date + '_' + request.auth.uid
        && next.total is int && next.total >= 0
        && next.saleCount is int && next.saleCount >= 1
        && next.itemCount is int && next.itemCount >= 1
        && (resource == null || (next.total >= resource.data.total
          && next.saleCount > resource.data.saleCount));
    }

    // Akun yang login memakai email undangan ini (email Google terverifikasi).
    function isInvitee(email) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }

    // Sama dengan MEMBER_NAME_MIN/MAX_LENGTH di src/config/limits.ts.
    function validMemberName(name) {
      return name is string && name.size() >= 2 && name.size() <= 30;
    }

    function inviteDoc(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    // Undangan baru dari pemilik toko (data sama di kedua lokasi undangan).
    function validInvite(email, storeId) {
      let data = request.resource.data;
      return email == email.lower()
        && data.keys().hasOnly(['storeId', 'storeName', 'displayName', 'invitedBy', 'createdAt'])
        && data.storeId == storeId
        && data.invitedBy == request.auth.uid
        && validMemberName(data.displayName)
        && data.createdAt == request.time;
    }

    // Kasir mengklaim undangan: data anggota cocok dengan undangan, dan undangan ikut dihapus.
    function isClaimingInvite(storeId) {
      let data = request.resource.data;
      return data.role == 'cashier'
        && data.isActive == true
        && isInvitee(data.email)
        && get(inviteDoc(data.email)).data.storeId == storeId
        && !existsAfter(inviteDoc(data.email));
    }

    // Toko yang SEDANG dibuat dalam transaksi yang sama dimiliki akun ini.
    function ownsStoreAfterWrite(storeId) {
      return getAfter(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid
        == request.auth.uid;
    }

    // ---- users/{uid}: penghubung akun → toko (1 akun = 1 toko) ----
    match /users/{uid} {
      allow read: if isSelf(uid);

      // Pemilik: dibuat bersama toko barunya. Kasir: dibuat bersama keanggotaan dari undangan.
      allow create: if isSelf(uid)
        && request.resource.data.storeId is string
        && ((request.resource.data.role == 'owner'
            && ownsStoreAfterWrite(request.resource.data.storeId))
          || (request.resource.data.role == 'cashier'
            && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeId)/members/$(uid)).data.role == 'cashier'));

      // Tidak bisa pindah toko atau mengubah peran sendiri.
      allow update, delete: if false;
    }

    // ---- invites/{email}: penunjuk undangan yang dicari kasir saat login (ID = email) ----
    match /invites/{email} {
      // Membaca undangan yang belum ada itu aman (tidak membuka apa pun).
      allow get: if signedIn()
        && (resource == null || isInvitee(email) || isOwner(resource.data.storeId));
      allow create: if signedIn()
        && isOwner(request.resource.data.storeId)
        && validInvite(email, request.resource.data.storeId);
      allow delete: if isInvitee(email) || (signedIn() && isOwner(resource.data.storeId));
      allow list, update: if false;
    }

    // ---- stores/{storeId} ----
    match /stores/{storeId} {
      allow read: if isActiveMember(storeId);

      // Akun yang belum punya toko boleh membuat satu toko dan menjadi pemiliknya.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && validStoreName(request.resource.data.name);

      allow update: if isOwner(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validStoreProfile(request.resource.data);

      allow delete: if false;

      // ---- members/{uid}: siapa saja yang boleh mengakses toko ----
      match /members/{uid} {
        allow read: if isActiveMember(storeId) && (isSelf(uid) || isOwner(storeId));

        // Pemilik saat membuat toko, atau kasir saat mengklaim undangannya.
        allow create: if isSelf(uid)
          && ((request.resource.data.role == 'owner'
              && request.resource.data.isActive == true
              && ownsStoreAfterWrite(storeId))
            || isClaimingInvite(storeId));

        // Pemilik mengaktifkan/menonaktifkan kasir (bukan dirinya sendiri, peran tak bisa diubah).
        allow update: if isOwner(storeId)
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive', 'displayName', 'updatedAt'])
          && request.resource.data.isActive is bool;
        allow delete: if false;
      }

      // ---- invites/{email}: daftar undangan kasir yang dilihat pemilik ----
      match /invites/{email} {
        allow read: if isOwner(storeId);
        allow create: if isOwner(storeId) && validInvite(email, storeId);
        allow delete: if isOwner(storeId) || isInvitee(email);
        allow update: if false;
      }

      // ---- products/{productId}: pemilik mengubah; kasir hanya mengurangi stok lewat penjualan ----
      match /products/{productId} {
        allow read: if isActiveMember(storeId);
        allow create: if isOwner(storeId) && validProduct(request.resource.data);
        allow update: if (isOwner(storeId) && validProduct(request.resource.data))
          || isSaleStockUpdate(storeId);
        allow delete: if false;
      }

      // ---- sales/{saleId}: tambah-saja; kasir hanya membaca penjualannya sendiri ----
      match /sales/{saleId} {
        allow read: if isOwner(storeId)
          || (isActiveMember(storeId) && resource.data.cashierUid == request.auth.uid);
        allow create: if isActiveMember(storeId) && validSale(request.resource.data);
        allow update, delete: if false;
      }

      // ---- dailyStats/{tanggal_uid}: rekap per kasir per hari, hanya bertambah ----
      match /dailyStats/{statId} {
        allow read: if isOwner(storeId)
          || (isActiveMember(storeId) && resource.data.cashierUid == request.auth.uid);
        allow create, update: if isActiveMember(storeId) && validDailyStat(statId);
        allow delete: if false;
      }

      // ---- barcodes/{barcode}: ID = barcode, menjamin satu barcode untuk satu barang ----
      match /barcodes/{barcode} {
        allow read: if isActiveMember(storeId);
        // Penunjuk harus cocok dengan barang yang memakai barcode ini setelah penulisan.
        allow create, update: if isOwner(storeId)
          && request.resource.data.keys().hasOnly(['productId'])
          && getAfter(/databases/$(database)/documents/stores/$(storeId)/products/$(request.resource.data.productId)).data.barcode == barcode;
        allow delete: if isOwner(storeId);
      }
    }
  }
}
